# Build / training scripts the API doesn't need
build_notebook.py
build_docs.py
build_deploy_guide.py
smoke_test.py

# Python caches
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/

# Editors
.vscode/
.idea/

# Streamlit-only bits — the API does not serve UI
src/app.py
